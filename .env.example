# BharatMentor Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "groq" | "gemini"
LLM_PROVIDER=groq

# Groq (https://console.groq.com — free tier available)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Gemini (https://aistudio.google.com — free tier available)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Database ──────────────────────────────────────────────────────────────────
# Use SQLite for local dev (default). Switch to PostgreSQL for production.
DATABASE_URL=sqlite:///./bharatmentor.db
# DATABASE_URL=postgresql://user:password@localhost:5432/bharatmentor

# ── STT ───────────────────────────────────────────────────────────────────────
STT_PROVIDER=whisper
# Options: "base" | "small" — "base" is faster; "small" is more accurate
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── TTS ───────────────────────────────────────────────────────────────────────
# Options: "gtts" | "browser"
TTS_PROVIDER=gtts

# ── RAG ───────────────────────────────────────────────────────────────────────
# Embedding model for sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Max chunks returned by retrieval
RAG_TOP_K=5

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
